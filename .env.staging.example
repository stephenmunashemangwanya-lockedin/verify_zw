# Staging operator template. Copy to a private runtime environment file and replace placeholders.
# Never commit credentials or provider-issued values.
STAGING_ENV_FILE=<path to private staging environment file>
BACKEND_IMAGE=<approved backend image reference>
FRONTEND_IMAGE=<approved frontend image reference>
VITE_API_BASE_URL=<approved staging API URL>
NODE_ENV=production
PORT=3000

DATABASE_URL=<Render PostgreSQL internal URL>
DB_NAME=<staging database name>
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=<operator-provided CA certificate path or value>
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=<generate a new staging secret>
JWT_ISSUER=<approved staging issuer>
JWT_AUDIENCE=<approved staging audience>
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=8h

FRONTEND_PUBLIC_URL=<approved staging frontend URL>
PASSWORD_RESET_FRONTEND_URL=<approved staging password reset URL>
CORS_ALLOWED_ORIGINS=<approved staging frontend URL>
CORS_ALLOW_CREDENTIALS=true
AUTH_COOKIE_NAME=verifyzw_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_MAX_AGE_MS=28800000
AUTH_RETURN_BEARER_TOKEN=false
CSRF_ENABLED=true
CSRF_COOKIE_NAME=verifyzw_csrf
CSRF_HEADER_NAME=x-csrf-token

EMAIL_PROVIDER=<approved staging email provider>
EMAIL_DELIVERY_URL=<operator-provided webhook URL>
EMAIL_DELIVERY_TOKEN=<operator secret>
EMAIL_FROM=<approved sender address>
EMAIL_DELIVERY_TIMEOUT_MS=10000
EMAIL_DELIVERY_MAX_RETRIES=3

IPFS_ENABLED=true
IPFS_PROVIDER=<approved IPFS provider>
IPFS_PROVIDER_API_URL=<operator-provided IPFS API URL>
PINATA_JWT=<operator secret>
PINATA_GATEWAY=<approved IPFS gateway URL>
IPFS_UPLOAD_TIMEOUT_MS=30000
IPFS_MAX_RETRIES=3
ALCHEMY_API_KEY=<operator secret>

BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=<approved staging network>
BLOCKCHAIN_RPC_URL=<approved staging RPC URL>
BLOCKCHAIN_CHAIN_ID=<approved chain ID>
CONTRACT_ADDRESS=<deployed staging contract address>
DEPLOYER_PRIVATE_KEY=<operator secret>
BLOCK_CONFIRMATIONS=1
BLOCKCHAIN_TX_TIMEOUT_MS=120000
BLOCKCHAIN_MAX_RETRIES=3
BLOCK_EXPLORER_URL=<approved staging block explorer URL>

RATE_LIMIT_STORE=<approved rate-limit store>
REDIS_URL=<authenticated Render Key Value internal URL>
REDIS_CONNECT_TIMEOUT_MS=5000
ENABLE_METRICS=true
METRICS_ROUTE=/metrics
METRICS_AUTH_MODE=<approved metrics authentication mode>
READINESS_TIMEOUT_MS=10000
TRUST_PROXY=1
LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILES=false
BACKUP_ENVIRONMENT=staging
BACKUP_DIRECTORY=<private backup directory>
PG_DUMP_PATH=<operator-provided pg_dump path>
PG_RESTORE_PATH=<operator-provided pg_restore path>
