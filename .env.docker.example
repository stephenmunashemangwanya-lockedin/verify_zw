# Copy to .env.docker and replace every CHANGE_ME value. Never commit .env.docker.
POSTGRES_DB=skill_verification
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_24_RANDOM_CHARACTERS
TEST_POSTGRES_PASSWORD=CHANGE_ME
BACKEND_PORT=3000
FRONTEND_PORT=5173
BLOCKCHAIN_PORT=8545
BLOCKCHAIN_ENABLED=false
FRONTEND_PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
AUTH_COOKIE_NAME=verifyzw_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE_MS=28800000
AUTH_COOKIE_PATH=/
AUTH_RETURN_BEARER_TOKEN=false
CSRF_ENABLED=true
CSRF_COOKIE_NAME=verifyzw_csrf
CSRF_HEADER_NAME=x-csrf-token
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
EMAIL_PROVIDER=capture
EMAIL_FROM=no-reply@example.invalid
EMAIL_DELIVERY_URL=https://email-provider.example.invalid/password-reset
EMAIL_DELIVERY_TOKEN=CHANGE_ME
EMAIL_DELIVERY_TIMEOUT_MS=5000
EMAIL_DELIVERY_MAX_RETRIES=3
VITE_API_BASE_URL=http://localhost:3000/api
# Production-only placeholders; supply these through an external secret manager.
BLOCKCHAIN_NETWORK=CHANGE_ME
BLOCKCHAIN_RPC_URL=https://CHANGE_ME.invalid
BLOCKCHAIN_CHAIN_ID=1
CONTRACT_ADDRESS=CHANGE_ME
DEPLOYER_PRIVATE_KEY=CHANGE_ME
IPFS_ENABLED=false
IPFS_PROVIDER=pinata
IPFS_PROVIDER_API_URL=https://api.pinata.cloud
PINATA_JWT=CHANGE_ME
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
IPFS_UPLOAD_TIMEOUT_MS=60000
IPFS_MAX_RETRIES=3
