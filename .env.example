PORT=3000
ENABLE_SWAGGER=true
SWAGGER_REQUIRE_AUTH=false
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skill_verification
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# Stage 23 API E2E isolation. The runner refuses DB_NAME and names without _test.
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=skill_verification_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=replace_with_test_database_password
TEST_DB_ADMIN_NAME=postgres
# Set true only to create a missing, guarded _test database. Existing databases
# are never dropped or recreated by the E2E runner.
CREATE_TEST_DB=false
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_ISSUER=zimbabwe-skill-verification-platform
JWT_AUDIENCE=zsvp-api
JWT_ALGORITHM=HS256
PASSWORD_MIN_LENGTH=12
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
CERTIFICATE_MAX_SIZE_MB=10
VERIFICATION_FILE_MAX_SIZE_MB=10
FRONTEND_PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
AUTH_COOKIE_NAME=verifyzw_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE_MS=28800000
AUTH_COOKIE_PATH=/
AUTH_RETURN_BEARER_TOKEN=false
CSRF_ENABLED=true
CSRF_COOKIE_NAME=verifyzw_csrf
CSRF_HEADER_NAME=x-csrf-token
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILES=false
LOG_DIRECTORY=logs
LOG_RETENTION_DAYS=14
LOG_MAX_SIZE=20m
LOG_COMPRESS=false
SLOW_REQUEST_MS=1000
SLOW_DATABASE_QUERY_MS=500
SLOW_IPFS_UPLOAD_MS=10000
SLOW_BLOCKCHAIN_TRANSACTION_MS=30000
ENABLE_METRICS=false
METRICS_ROUTE=/metrics
METRICS_AUTH_MODE=admin
READINESS_TIMEOUT_MS=2000

# Stage 25 recovery. PostgreSQL client executables may be absolute paths.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
BACKUP_DIRECTORY=backups
BACKUP_ENVIRONMENT=development
BACKUP_MAX_AGE_HOURS=48
BACKUP_DAILY_DAYS=14
BACKUP_WEEKLY_WEEKS=8
BACKUP_MONTHLY_MONTHS=12
RESTORE_DB_NAME=skill_verification_restore_test
CONFIRM_TEST_RESTORE=false
FILE_RESTORE_DIRECTORY=restore-test/files
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Explicit operations-only administrator commands. Never store real credentials here.
ALLOW_ADMIN_BOOTSTRAP=false
ALLOW_ADMIN_BOOTSTRAP_OVERRIDE=false
# Runtime-only names: BOOTSTRAP_ADMIN_FULL_NAME, BOOTSTRAP_ADMIN_EMAIL,
# BOOTSTRAP_ADMIN_PASSWORD, ADMIN_RESET_PASSWORD

# Narrow rate limits. Use a shared store when horizontally scaled.
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=5
ADMIN_ACTION_RATE_LIMIT_MAX=100

# Public password recovery. Capture is development-only and does not send mail.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
EMAIL_PROVIDER=capture
EMAIL_FROM=no-reply@example.invalid
EMAIL_DELIVERY_URL=https://email-provider.example.invalid/password-reset
EMAIL_DELIVERY_TOKEN=replace_with_email_provider_token
EMAIL_DELIVERY_TIMEOUT_MS=5000
EMAIL_DELIVERY_MAX_RETRIES=3

# Pinata/IPFS configuration. Never commit a real JWT.
IPFS_PROVIDER=pinata
PINATA_JWT=replace_with_pinata_jwt
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
IPFS_UPLOAD_TIMEOUT_MS=60000
IPFS_MAX_RETRIES=3

# EVM blockchain configuration. Never commit a real private key or RPC secret.
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=https://replace-with-sepolia-rpc.example
BLOCKCHAIN_CHAIN_ID=11155111
DEPLOYER_PRIVATE_KEY=0x_replace_with_64_hex_characters
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCK_CONFIRMATIONS=1
BLOCKCHAIN_TX_TIMEOUT_MS=120000
BLOCKCHAIN_MAX_RETRIES=3
BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# Public verification limits (in-memory limiter; use a shared store when scaled).
VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
VERIFICATION_RATE_LIMIT_MAX=60
FILE_VERIFICATION_RATE_LIMIT_MAX=20
TOKEN_VERIFICATION_RATE_LIMIT_MAX=60
