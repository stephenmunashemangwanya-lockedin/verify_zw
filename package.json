{
  "name": "zimbabwe-skill-verification-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "admin:bootstrap": "node scripts/bootstrapAdmin.js",
    "admin:reset-password": "node scripts/resetAdminPassword.js",
    "migrate": "node backend/database/runMigrations.js",
    "test:migration": "node backend/database/verifyMigration.js",
    "test:ipfs": "node --test --test-concurrency=1 test/stage8Ipfs.test.js",
    "compile:contract": "hardhat compile",
    "export:contract-abi": "node scripts/exportContractAbi.js",
    "test:contract": "hardhat test",
    "test:blockchain-local": "node test/localBlockchainIntegration.js",
    "test:blockchain": "node --test --test-concurrency=1 test/blockchainConfiguration.test.js test/credentialBlockchainModel.test.js",
    "test:verification": "node --test --test-concurrency=1 test/publicVerification.test.js",
    "test:revocation": "node --test --test-concurrency=1 test/credentialRevocation.test.js",
    "test:qr": "node --test --test-concurrency=1 test/qrSupport.test.js",
    "test:pdf": "node --test --test-concurrency=1 test/generatedPdf.test.js",
    "test:audit": "node --test --test-concurrency=1 test/auditLogging.test.js",
    "test:users": "node --test --test-concurrency=1 test/userManagement.test.js",
    "test:validation": "node --test --test-concurrency=1 test/validation.test.js",
    "test:errors": "node --test --test-concurrency=1 test/errorHandling.test.js",
    "test:security": "node --test --test-concurrency=1 test/securityHardening.test.js",
    "test:health": "node --test --test-concurrency=1 test/healthMonitoring.test.js",
    "test:observability": "node --test --test-concurrency=1 test/observability.test.js",
    "test:metrics": "node --test --test-concurrency=1 test/metrics.test.js",
    "logs:clean": "node scripts/cleanLogs.js",
    "metrics:smoke": "node --test --test-name-pattern=\"metrics endpoint\" test/metrics.test.js",
    "test:pagination": "node --test --test-concurrency=1 test/paginationAndSearch.test.js",
    "test:dashboard": "node --test --test-concurrency=1 test/dashboardAnalytics.test.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend run test",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:preview": "npm --prefix frontend run preview",
    "docs:validate": "node scripts/validateDocumentation.js",
    "docs:openapi": "node scripts/validateDocumentation.js --openapi-only",
    "test:docs": "node --test --test-concurrency=1 test/apiDocumentation.test.js",
    "test": "npm run test:backend",
    "test:backend": "node --test --test-concurrency=1 test/*.test.js",
    "test:backend:coverage": "c8 --all --src backend --exclude backend/database/migrations/** --exclude test/** --exclude scripts/** --reporter=text --reporter=html --reporter=lcov --reporter=json-summary --check-coverage --lines=65 --functions=60 --branches=70 --statements=65 node --test --test-concurrency=1 test/*.test.js",
    "test:frontend": "npm run frontend:test",
    "test:frontend:coverage": "npm --prefix frontend run test:coverage",
    "test:contract:coverage": "hardhat coverage",
    "test:e2e:api": "node scripts/runApiE2E.js",
    "test:e2e:frontend": "node scripts/runFrontendE2E.js",
    "test:accessibility": "node scripts/runFrontendE2E.js --accessibility",
    "test:release": "node --test --test-concurrency=1 test/release/releaseReadiness.test.js",
    "test:all": "npm run docs:validate && npm run test:backend && npm run test:frontend && npm run test:contract && npm run test:blockchain-local && npm run test:e2e:api && npm run test:e2e:frontend && npm run test:accessibility && npm run frontend:build && npm run test:release",
    "coverage:report": "node scripts/reportCoverage.js",
    "node:blockchain": "hardhat node",
    "deploy:contract": "hardhat run scripts/deployCredentialRegistry.js",
    "reconcile:blockchain": "node scripts/reconcileBlockchainCredentials.js",
    "backup:db": "node scripts/backupDatabase.js",
    "backup:files": "node scripts/backupFiles.js",
    "backup:verify": "node scripts/verifyBackup.js",
    "restore:db:test": "node scripts/restoreDatabase.js",
    "restore:files:test": "node scripts/restoreFiles.js",
    "test:recovery": "node --test --test-concurrency=1 test/recovery.test.js",
    "integrity:check": "node scripts/checkDatabaseIntegrity.js",
    "retention:dry-run": "node scripts/retentionBackups.js",
    "test:recovery:integration": "node scripts/runRecoveryDrill.js",
    "test:docker": "node --test --test-concurrency=1 test/dockerConfiguration.test.js",
    "docker:build": "docker compose --env-file .env.docker --profile local build",
    "docker:up": "docker compose --env-file .env.docker --profile local up -d",
    "docker:down": "docker compose --env-file .env.docker --profile local down",
    "docker:down:volumes": "docker compose --env-file .env.docker down --volumes",
    "docker:logs": "docker compose --env-file .env.docker --profile local logs --follow",
    "docker:migrate": "docker compose --env-file .env.docker run --rm migration",
    "docker:deploy-contract": "docker compose --env-file .env.docker --profile local run --rm contract-deploy",
    "docker:test": "docker compose -f docker-compose.test.yml --env-file .env.docker up --build --abort-on-container-exit --exit-code-from test_runner",
    "docker:backup": "docker compose --env-file .env.docker --profile tools run --rm backup",
    "docker:restore:test": "docker compose --env-file .env.docker --profile tools run --rm restore-test",
    "ci:validate": "node scripts/validateWorkflows.js && node --test --test-concurrency=1 test/ciConfiguration.test.js && npm run docs:validate",
    "ci:test": "npm run test:backend && npm run test:frontend && npm run test:contract && npm run test:migration && npm run test:recovery && npm run test:docker && npm run test:release",
    "ci:security": "node scripts/scanCiArtifacts.js",
    "security:dependencies": "node scripts/checkDependencySecurity.js",
    "ci:docker": "npm run test:docker && docker compose -f docker-compose.test.yml --env-file .env.docker config --quiet",
    "ci:release-check": "npm run ci:validate && npm run ci:test && npm run frontend:build && npm run ci:security",
    "performance:smoke": "node scripts/performance/runPerformance.js --profile smoke",
    "performance:load": "node --expose-gc scripts/performance/runPerformance.js --profile load",
    "performance:test": "npm run performance:smoke"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "canonicalize": "2.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.4.0",
    "c8": "^12.0.0",
    "hardhat": "^2.29.0",
    "nodemon": "^3.1.14",
    "solidity-coverage": "^0.8.17"
  }
}
