      {"name":"Register verifier","request":{"auth":{"type":"noauth"},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"fullName\": \"Example Verifier\",\n  \"email\": \"verifier@example.org\",\n  \"password\": \"<STRONG_PASSWORD>\",\n  \"role\": \"verifier\"\n}"},"url":"{{baseUrl}}/api/auth/register"}},
      {"name":"Login","event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) { const body = pm.response.json(); const csrf=pm.response.headers.get('X-CSRF-Token'); if (csrf) pm.environment.set('csrfToken', csrf); if (body.token) pm.environment.set('token', body.token); pm.test('Login succeeded', () => pm.expect(body.success).to.eql(true)); }"]}}],"request":{"auth":{"type":"noauth"},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"admin@example.org\",\n  \"password\": \"<PASSWORD>\"\n}"},"url":"{{baseUrl}}/api/auth/login"}},
