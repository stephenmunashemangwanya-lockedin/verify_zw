{
  "info":{"name":"Zimbabwe Skill Verification Platform API","description":"Cookie sessions are stored by the Postman cookie jar and unsafe requests echo the non-secret CSRF response proof. Bearer mode requires explicit server compatibility configuration. Uses placeholders only; mutating requests are not run automatically.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
