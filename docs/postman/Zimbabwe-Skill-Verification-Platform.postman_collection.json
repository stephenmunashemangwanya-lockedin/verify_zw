  "event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (['POST','PUT','PATCH','DELETE'].includes(pm.request.method)) { const csrf = pm.environment.get('csrfToken'); if (csrf && !String(csrf).startsWith('<')) pm.request.headers.upsert({key:'X-CSRF-Token', value:csrf}); }"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Response is controlled', function () { pm.expect(pm.response.code).to.be.below(500); });","pm.test('Response time is reasonable', function () { pm.expect(pm.response.responseTime).to.be.below(30000); });","const type = pm.response.headers.get('Content-Type') || ''; if (type.includes('application/json')) { const body = pm.response.json(); pm.test('JSON has a status marker', function () { pm.expect(body).to.be.an('object'); }); }"]}}],
